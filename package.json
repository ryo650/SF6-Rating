{
  "name": "sf6-rating",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "supabase": "supabase",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db && bash scripts/test-db-concurrency.sh && bash scripts/test-phase2-concurrency.sh",
    "test:auth:local": "node scripts/test-phase2-auth.mjs",
    "db:lint": "supabase db lint --local --level warning",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "latest",
    "sharp": "^0.35.3",
    "unicode-case-folding": "1.1.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "latest",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "^9.39.0",
    "eslint-config-next": "latest",
    "jsdom": "^26.1.0",
    "prettier": "latest",
    "supabase": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
