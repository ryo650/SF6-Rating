# Public Supabase project URL. Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase publishable key. Dashboard > Project Settings > API.
# Do not use the service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key used by trusted Phase 2 domain actions and Auth admin deletion.
# Never expose this value through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only high-entropy pepper for keyed SF6 User Code deletion digests.
SF6_USER_CODE_RECLAIM_PEPPER=

# Canonical application origin used to construct Auth redirect URLs.
APP_BASE_URL=http://127.0.0.1:3000
